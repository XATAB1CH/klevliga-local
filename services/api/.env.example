# Loaded from the directory containing config.yaml. Process variables take precedence.
API_ADDRESS=127.0.0.1:8080
# Set true when the browser accesses the site through public HTTPS.
COOKIE_SECURE=false
TRUST_LOOPBACK_PROXY=false
MAIL_MODE=log
# auto uses implicit TLS on 465 and STARTTLS on other ports.
SMTP_TLS_MODE=auto
SMTP_ADDRESS=mail.hosting.reg.ru:465
SMTP_USERNAME=noreply@klevliga.ru
SMTP_PASSWORD=
SMTP_FROM=noreply@klevliga.ru
AUTH_VERIFICATION_SECRET=
